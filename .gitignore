# UEBERARBEITET (Punkt 4, Projekt-Hygiene): Ausgabeverzeichnisse als Ganzes
# ignorieren statt einzelner Endungen. '*.json'/'*.csv' global auszuschliessen
# traf auch kuenftige Konfigurationsdateien im Quellbaum.
messungen/
konfiguration/
# NEU: Ablage von tools/hardware/probe_measure_all_elements.py.
messwerte/
*.txt

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
# Die virtuelle Umgebung selbst. 'python -m venv' legt zwar ein eigenes
# venv/.gitignore mit '*' an - das faellt aber weg, sobald die Umgebung mit
# einem anderen Werkzeug (virtualenv, uv) neu angelegt wird.
venv/
.venv/

dist/
build/
*.egg-info/

# Editor / OS
.idea/
.vscode/
.DS_Store

# P-7: Verbindungsparameter dieses Rechners - Zugangsdaten gehoeren nicht in
# die Versionsverwaltung. Vorlage: wt3000.example.json
wt3000.json
